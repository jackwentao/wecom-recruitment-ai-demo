PORT=3001
APP_BASE_URL=http://localhost:5173

# 存储配置：json 适合本地演示，mysql 适合真实联调。
DATA_STORE=json
DATA_FILE=data/app-data.json

# DATA_STORE=mysql 时填写。
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=recruitment_ai
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_CONNECTION_LIMIT=10

# 企业微信智能机器人 API 回调配置。
WECOM_BOT_TOKEN=请填写企业微信后台配置的Token
WECOM_BOT_ENCODING_AES_KEY=请填写43位EncodingAESKey
WECOM_BOT_RECEIVE_ID=
WECOM_CALLBACK_PUBLIC_URL=https://你的内网穿透域名/api/wecom/aibot/callback
WECOM_REPLY_ENABLED=true

# 如需自动下载群内PDF文件，请配置机器人应用对应的企业微信凭证。
WECOM_CORP_ID=
WECOM_APP_SECRET=

# OpenAI 兼容模型配置，可接 DeepSeek 或其他兼容服务。
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
AI_MODEL=deepseek-v4-flash
